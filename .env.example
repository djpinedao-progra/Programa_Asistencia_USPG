APP_ENV=development
# No reutilices la base ni las credenciales de main.
DATABASE_URL=sqlite:///luis_independiente.db
# Solo PostgreSQL: permite aislar tablas de prueba sin crear otra instancia.
DB_SCHEMA=
APP_BASE_URL=http://127.0.0.1:5001
APP_TIMEZONE=America/Guatemala
ATTENDANCE_CLOSE_GRACE_MINUTES=30
# La integraciÃ³n permanece oculta mientras este valor sea false.
GOOGLE_CLASSROOM_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5001/admin/google/callback
# Usa una cadena larga, aleatoria y distinta de SECRET_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# development (local) o production (servidor publicado)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
# Local: SQLite. MySQL: mysql+pymysql://root:password@localhost:3306/uspg_asistencia?charset=utf8mb4
DATABASE_URL=sqlite:///asistencia.db
# Dirección que llevan los códigos QR. Con teléfonos en la misma red: http://IP-DE-TU-COMPUTADORA:5000
APP_BASE_URL=http://localhost:5000
APP_TIMEZONE=America/Guatemala
# El dominio del correo define el rol: @administrador.uspg.edu.gt, @catedratico.uspg.edu.gt, @alumno.uspg.edu.gt
ADMIN_EMAIL=admin@administrador.uspg.edu.gt
ADMIN_PASSWORD=change-this-password
# Servidor de correo para "¿Olvidaste tu contraseña?". Sin estos datos la recuperación no envía nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
